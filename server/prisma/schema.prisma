generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum IdDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

// ─── Auth & Users ───────────────────────────────────────

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  phone            String           @unique
  passwordHash     String
  idDocumentUrl    String?
  idDocumentStatus IdDocumentStatus  @default(PENDING)
  isEmailVerified  Boolean          @default(false)
  rejectionReason  String?
  otps             Otp[]
  orders           Order[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Otp {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  consumed  Boolean    @default(false)
  createdAt DateTime   @default(now())
}

// ─── Package Tourism (kept for tour packages) ───────────

model Country {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  cities    City[]
  packages  Package[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model City {
  id        String    @id @default(cuid())
  countryId String
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  slug      String    @unique
  image     String?
  latitude  Float?
  longitude Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Package {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  countryId     String
  country       Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  durationDays  Int
  coverImage    String?
  summary       String?
  priceFrom     Decimal?       @db.Decimal(10, 2)
  isActive      Boolean        @default(true)
  itineraryDays ItineraryDay[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ItineraryDay {
  id          String   @id @default(cuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PackageEnquiry {
  id           String   @id @default(cuid())
  packageId    String?
  packageTitle String
  countryName  String?
  priceDisplay String?
  customerName String
  phone        String
  email        String
  travelDate   String?
  pax          Int      @default(1)
  notes        String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SightseeingTour {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  cityName       String?
  countryName    String?
  duration       String
  priceFrom      Decimal  @db.Decimal(10, 2)
  coverImage     String?
  galleryImages  String?  // JSON stringified array of URLs
  summary        String?
  description    String?  @db.Text
  highlights     String?  // JSON stringified array of highlight bullet points
  includes       String?  // JSON stringified array of included items
  options        String?  // JSON stringified array of options [{ name, price, duration }]
  schedule       String?  // JSON stringified schedule [{ type, address, metro, time }]
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SightseeingEnquiry {
  id               String   @id @default(cuid())
  sightseeingId    String?
  sightseeingTitle String
  optionSelected   String?
  cityName         String?
  priceDisplay     String?
  customerName     String
  phone            String
  email            String
  travelDate       String?
  pax              Int      @default(1)
  notes            String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Transfer Booking System (new) ──────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String
  city      String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  fromRoutes Route[] @relation("FromLocation")
  toRoutes   Route[] @relation("ToLocation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarType {
  id          String       @id @default(cuid())
  name        String
  seats       Int
  image       String?
  isAC        Boolean      @default(true)
  isWiFi      Boolean      @default(false)
  isLuggage   Boolean      @default(true)
  isChildSeat Boolean      @default(false)
  isVIP       Boolean      @default(false)
  isPetFriendly Boolean    @default(false)
  isActive    Boolean      @default(true)
  routePrices RoutePrice[]
  bookings    Booking[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Route {
  id             String       @id @default(cuid())
  fromLocationId String
  fromLocation   Location     @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Cascade)
  toLocationId   String
  toLocation     Location     @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true)
  routePrices    RoutePrice[]
  bookings       Booking[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fromLocationId, toLocationId])
}

model RoutePrice {
  id        String   @id @default(cuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  carTypeId String
  carType   CarType  @relation(fields: [carTypeId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routeId, carTypeId])
}

// ─── Van & Coach (Vehicle at Disposal) ──────────────────

model VanCoachVehicle {
  id              String               @id @default(cuid())
  name            String
  seats           Int
  image           String?
  category        String?
  description     String?
  rate8h          Decimal              @db.Decimal(10, 2)
  rate10h         Decimal              @db.Decimal(10, 2)
  overtimeRate    Decimal              @db.Decimal(10, 2)
  currency        String               @default("USD")
  isActive        Boolean              @default(true)
  order           Int                  @default(0)
  routePrices     VanCoachRoutePrice[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

enum VanCoachPriceGroup {
  AIRPORT_TRANSFER
  POINT_TO_POINT
  TOUR_PACKAGE
}

model VanCoachRoutePrice {
  id        String              @id @default(cuid())
  vehicleId String
  vehicle   VanCoachVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  group     VanCoachPriceGroup
  label     String
  price     Decimal             @db.Decimal(10, 2)
  order     Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

// ─── Private Transfers (City-wise Sedan/Minivan Pricing) ────

model PrivateTransferCity {
  id        String                 @id @default(cuid())
  name      String
  slug      String                 @unique
  coverImage String?
  isActive  Boolean                @default(true)
  order     Int                    @default(0)
  routes    PrivateTransferRoute[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model PrivateTransferRoute {
  id          String              @id @default(cuid())
  cityId      String
  city        PrivateTransferCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  description String
  sedanPrice  Decimal             @db.Decimal(10, 2)
  minivanPrice Decimal            @db.Decimal(10, 2)
  currency    String              @default("GBP")
  isActive    Boolean             @default(true)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PrivateTransferEnquiry {
  id               String   @id @default(cuid())
  cityName         String
  routeDescription String
  vehicleType      String
  price            Decimal  @db.Decimal(10, 2)
  currency         String   @default("GBP")
  customerName     String
  phone            String
  email            String
  pickupDate       String?
  pickupTime       String?
  notes            String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model VanCoachEnquiry {
  id           String   @id @default(cuid())
  vehicleId    String?
  vehicleName  String
  location     String
  hours        Int
  rate         Decimal  @db.Decimal(10, 2)
  customerName String
  phone        String
  email        String
  pickupAddress String?
  notes        String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id            String        @id @default(cuid())
  routeId       String
  route         Route         @relation(fields: [routeId], references: [id], onDelete: Restrict)
  carTypeId     String
  carType       CarType       @relation(fields: [carTypeId], references: [id], onDelete: Restrict)
  customerName  String
  phone         String
  email         String?
  pickupAddress String
  dropAddress   String
  travelDate    DateTime
  travelTime    String?
  pax           Int
  luggageNotes  String?
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR")
  paymentStatus PaymentStatus @default(PENDING)
  bookingStatus BookingStatus @default(PENDING)
  paymentId     String?
  message       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── Unified Order System (Sightseeing / Packages / Van-Coach) ──

enum OrderProductType {
  SIGHTSEEING
  PACKAGE
  VAN_COACH
}

enum OrderStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Order {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  productType      OrderProductType
  productId        String
  productName      String
  amount           Decimal         @db.Decimal(10, 2)
  currency         String          @default("EUR")
  amountInr        Decimal?        @db.Decimal(10, 2)
  eurToInrRate     Decimal?        @db.Decimal(10, 4)
  razorpayOrderId  String?
  razorpayPaymentId String?
  razorpaySignature String?
  status           OrderStatus     @default(CREATED)
  customerName     String
  customerEmail    String
  customerPhone    String
  travelDate       String?
  pax              Int             @default(1)
  optionSelected   String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

// ─── Site Settings (singleton) ──────────────────────────

model SiteSettings {
  id                       String   @id @default("singleton")
  showPrivateTransfers     Boolean  @default(true)
  showVanCoach             Boolean  @default(true)
  showPackages             Boolean  @default(true)
  showSightseeing          Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// ─── Testimonials ───────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  rating      Int
  message     String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── SEO Pages ──────────────────────────────────────────

model SeoPage {
  id                   String   @id @default(cuid())
  title                String
  slug                 String   @unique
  linkedCategory       String?
  pageDescription      String?
  cityContent          String?
  additionalSeoContent String?
  faqs                 Json?
  metaTitle            String?
  metaDescription      String?
  metaKeywords         String?
  status               String   @default("ACTIVE")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ─── Blog System ────────────────────────────────────────

model BlogCategory {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  metaTitle       String?
  metaDescription String?
  posts           BlogPost[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String?
  coverImage      String?
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            BlogPostTag[]
  status          String        @default("DRAFT")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

